{
  "name": "nova-genesis-core",
  "version": "1.1.0",
  "description": "NOVA Genesis Personal Operating Intelligence System",
  "author": "NOVA Genesis Team",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=18.17",
    "electron": ">=28"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && vite build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build --config vite.config.mts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --no-config-lookup scripts --ext .js",
    "test": "npm run build && node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js",
    "electron:start": "tsc -p tsconfig.main.json && electron .",
    "electron:package": "npm run build && electron-builder --publish=never",
    "rebuild-native": "npx electron-rebuild -f --only better-sqlite3,isolated-vm,@picovoice/porcupine-node,@ricky0123/vad-node,onnxruntime-node",
    "rebuild-native-partial": "npx electron-rebuild -f --only better-sqlite3,@picovoice/porcupine-node,@ricky0123/vad-node,onnxruntime-node",
    "postinstall": "npm run rebuild-native-partial",
    "e2e:smoke": "node scripts/e2e-smoke.js"
  },
  "build": {
    "appId": "com.nova.genesis",
    "productName": "Nova Genesis",
    "asar": false,
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "native_modules/**/*",
      "build/icon.png",
      "python/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native_modules/",
        "to": "native_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA Genesis"
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@picovoice/porcupine-node": "^4.0.2",
    "@ricky0123/vad-node": "^0.0.3",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.7",
    "hls.js": "^1.6.2",
    "isolated-vm": "^6.1.2",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "1.21.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0-beta.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@webgpu/types": "^0.1.71",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0-beta.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
